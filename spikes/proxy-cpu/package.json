{
  "name": "@spikes/proxy-cpu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Go/No-Go spike: proxy streaming de 20 MB sin buffering y CPU por request (Task 8)",
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc --port 8807 --inspector-port 9240 --ip 127.0.0.1",
    "dev:elysia": "wrangler dev -c wrangler.elysia.jsonc --port 8810 --inspector-port 9241 --ip 127.0.0.1",
    "dev:elysia-schema": "wrangler dev -c wrangler.elysia-schema.jsonc --port 8812 --inspector-port 9242 --ip 127.0.0.1",
    "sink": "bun scripts/sink.ts",
    "upload": "bun scripts/upload.ts",
    "measure": "bun scripts/measure-cpu.ts",
    "bench": "bun scripts/bench.ts",
    "summary": "bun scripts/summarize.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "22.20.5",
    "bun-types": "1.3.11",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
